# Add these as separate variables/secrets in Cloudflare Pages → Settings → Variables and Secrets.
# Do not put real credentials in this example file or commit a populated .env file.
ADMIN_USERNAME=ashin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Contact form delivery uses Resend from a Cloudflare Pages Function.
# Keep these server-side in Cloudflare Pages settings; do not prefix them with VITE_.
RESEND_API_KEY=re_your_resend_api_key
# Verified sender address (must use your Resend-verified domain); the form submitter is the display name/reply-to.
CONTACT_FROM_EMAIL=contact@your-verified-domain.com
CONTACT_TO_EMAIL=your-inbox@example.com

# D1 is configured as a Wrangler binding in wrangler.jsonc; it is not a .env value.
# Required binding name: CONTENT_DB
