# Add these as separate variables/secrets in Cloudflare Pages → Settings → Variables and Secrets.
# Do not put real credentials in this example file or commit a populated .env file.
ADMIN_USERNAME=ashin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

